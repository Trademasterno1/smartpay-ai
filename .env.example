# PayPal Sandbox credentials — never commit your real .env file
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_secret
PAYPAL_ENV=sandbox

# AI provider key (Gemini or another supported provider will be configured next)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key

PORT=3000
